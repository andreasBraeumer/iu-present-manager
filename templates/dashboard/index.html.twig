{% extends 'base_app.html.twig' %}

{% block title %}{{ 'dashboard.title'|trans }}{% endblock %}

{% block content %}
    <h1 class="text-light">{{ 'dashboard.title'|trans }}</h1>

    {% if geburtstage is empty %}
        <p class="text-light">{{ 'dashboard.keineGeburtstage'|trans }}</p>
    {% else %}
        <div class="alert alert-info">
            <strong>{{ 'dashboard.geburtstageTitel'|trans }}</strong>
            <ul class="mb-0">
                {% for person in geburtstage %}
                    <li>
                        <a href="{{ path('app_person_show', {id: person.id}) }}">
                            {{ person.vorname }} {{ person.nachname }}
                        </a>
                        – {{ person.geburtsdatum|date('d.m.') }}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {% if benachrichtigungen is not empty %}
        <h2 class="text-light h5 mt-4">{{ 'benachrichtigungen.title'|trans }}</h2>
        <ul class="list-group mb-3">
            {% for benachrichtigung in benachrichtigungen %}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>
                        <a href="{{ path('app_person_show', {id: benachrichtigung.person.id}) }}">
                            {{ benachrichtigung.person.vorname }}
                        </a>
                        – {{ benachrichtigung.inhalt }}
                    </span>
                    <form method="post" action="{{ path('app_benachrichtigung_gelesen', {id: benachrichtigung.id}) }}">
                        <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                        <button class="btn btn-sm btn-outline-secondary" type="submit">{{ 'benachrichtigungen.gelesen'|trans }}</button>
                    </form>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <div class="d-flex gap-2 mt-3">
        <a href="{{ path('app_person_index') }}" class="btn btn-primary">{{ 'nav.personen'|trans }}</a>
        <a href="{{ path('app_anlass_index') }}" class="btn btn-secondary">{{ 'nav.anlaesse'|trans }}</a>
    </div>
{% endblock %}
