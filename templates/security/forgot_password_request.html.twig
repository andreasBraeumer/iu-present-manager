{% extends 'base.html.twig' %}

{% block title %} {{ 'resetPassword.title'|trans }} {% endblock %}

{% block body %}
    <div class="d-flex align-items-center vh-100">
        <main class="form-signin w-100 m-auto">
            <h1 class="h3 mb-3 fw-normal">{{ 'resetPassword.title'|trans }}</h1>

            {% if not_found %}
                <div class="alert alert-danger">{{ 'resetPassword.benutzerNichtGefunden'|trans }}</div>
            {% endif %}

            {% if reset_link %}
                <div class="alert alert-success">
                    {{ 'resetPassword.linkErstellt'|trans }}<br>
                    <a href="{{ reset_link }}">{{ reset_link }}</a>
                </div>
            {% else %}
                <form method="post">
                    <p class="text-muted">{{ 'resetPassword.hinweis'|trans }}</p>

                    <div class="form-floating">
                        <input type="text"
                               name="username"
                               id="username"
                               class="form-control"
                               placeholder="{{ 'login.username'|trans }}"
                               autocomplete="username"
                               required
                               autofocus>
                        <label for="username">{{ 'login.username'|trans }}</label>
                    </div>

                    <input type="hidden" name="_token" value="{{ csrf_token('forgot_password') }}">

                    <button class="btn btn-primary w-100 py-2 mt-2" type="submit">
                        {{ 'resetPassword.linkAnfordern'|trans }}
                    </button>
                </form>
            {% endif %}

            <a href="{{ path('app_login') }}" class="d-flex justify-content-center w-100 py-2">
                {{ 'resetPassword.zurueckZumLogin'|trans }}
            </a>
        </main>
    </div>
{% endblock %}
