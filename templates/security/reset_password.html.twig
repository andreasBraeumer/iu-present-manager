{% extends 'base.html.twig' %}

{% block title %} {{ 'resetPassword.neuesPasswortTitle'|trans }} {% endblock %}

{% block body %}
    <div class="d-flex align-items-center vh-100">
        <main class="form-signin w-100 m-auto">
            <h1 class="h3 mb-3 fw-normal">{{ 'resetPassword.neuesPasswortTitle'|trans }}</h1>

            {% if error %}
                <div class="alert alert-danger">{{ error|trans }}</div>
            {% endif %}

            <form method="post">
                <div class="form-floating">
                    <input type="password"
                           name="password"
                           id="password"
                           class="form-control"
                           placeholder="{{ 'resetPassword.neuesPasswort'|trans }}"
                           autocomplete="new-password"
                           required
                           autofocus>
                    <label for="password">{{ 'resetPassword.neuesPasswort'|trans }}</label>
                </div>
                <div class="form-floating mt-2">
                    <input type="password"
                           name="repeat_password"
                           id="repeat_password"
                           class="form-control"
                           placeholder="{{ 'resetPassword.neuesPasswortWiederholen'|trans }}"
                           autocomplete="new-password"
                           required>
                    <label for="repeat_password">{{ 'resetPassword.neuesPasswortWiederholen'|trans }}</label>
                </div>

                <input type="hidden" name="_token" value="{{ csrf_token('reset_password') }}">

                <button class="btn btn-primary w-100 py-2 mt-2" type="submit">
                    {{ 'resetPassword.speichern'|trans }}
                </button>
            </form>
        </main>
    </div>
{% endblock %}
