<div
    class="d-flex flex-column flex-shrink-0 p-3 text-bg-dark"
    style="width: 280px"
>
    <a
        href="{{ path('app_dashboard') }}"
        class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none"
    >
        <span class="fs-4">{{ 'nav.brand'|trans }}</span>
    </a>
    <hr />
    <ul class="nav nav-pills flex-column mb-auto">
        <li class="nav-item">
            <a href="{{ path('app_dashboard') }}" class="nav-link {{ app.current_route == 'app_dashboard' ? 'active' : 'text-white' }}">
                {{ 'nav.dashboard'|trans }}
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_person_index') }}" class="nav-link {{ app.current_route starts with 'app_person' ? 'active' : 'text-white' }}">
                {{ 'nav.personen'|trans }}
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_anlass_index') }}" class="nav-link {{ app.current_route starts with 'app_anlass' ? 'active' : 'text-white' }}">
                {{ 'nav.anlaesse'|trans }}
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_export_html') }}" class="nav-link {{ app.current_route == 'app_export_html' ? 'active' : 'text-white' }}">
                {{ 'nav.export'|trans }}
            </a>
        </li>
    </ul>
    <hr />
    <div class="dropdown">
        <a
            href="#"
            class="d-flex align-items-center text-white text-decoration-none dropdown-toggle"
            data-bs-toggle="dropdown"
            aria-expanded="false"
        >
            <strong>{{ app.user ? app.user.userIdentifier : '' }}</strong>
        </a>
        <ul class="dropdown-menu dropdown-menu-dark text-small shadow">
            <li><a class="dropdown-item" href="{{ path('app_logout') }}">{{ 'login.logout'|trans }}</a></li>
        </ul>
    </div>
</div>
